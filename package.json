{
	"name": "obsidian-topk-visual-search",
	"version": "2.1.0",
	"description": "Find the exact PDF page or image in your vault from a plain-language query, powered by TopK.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"typecheck": "tsc -noEmit && tsc -noEmit -p tsconfig.node.json && tsc -noEmit -p tests/e2e/tsconfig.json",
		"test": "vitest run --project unit --project integration",
		"test:contract": "vitest run --project contract",
		"test:live": "vitest run --project live",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"bench": "tsx bench/runners/index.ts",
		"bench:fetch": "tsx bench/fetch.ts",
		"bench:hero": "tsx bench/hero.ts",
		"bench:labels": "tsx bench/labels.ts",
		"proto": "buf generate vendor/topk-protos",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"check": "npm run lint && npm run typecheck && npm run test && npm run test:contract && npm run build && npm run check:bundle",
		"check:bundle": "tsx scripts/check-bundle.ts"
	},
	"keywords": [
		"obsidian",
		"topk",
		"visual-search"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davidmyriel/obsidian-topk.git"
	},
	"bugs": {
		"url": "https://github.com/davidmyriel/obsidian-topk/issues"
	},
	"homepage": "https://github.com/davidmyriel/obsidian-topk#readme",
	"engines": {
		"node": ">=24"
	},
	"private": true,
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0"
	},
	"devDependencies": {
		"@bufbuild/buf": "1.75.0",
		"@bufbuild/protoc-gen-es": "2.16.0",
		"@eslint/js": "9.39.5",
		"@napi-rs/canvas": "1.0.13",
		"@types/node": "22.20.5",
		"@wdio/cli": "9.32.0",
		"@wdio/local-runner": "9.32.0",
		"@wdio/mocha-framework": "9.32.0",
		"@wdio/spec-reporter": "9.32.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.0",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"minisearch": "7.1.2",
		"obsidian": "1.14.4",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.4.299",
		"prettier": "3.9.10",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.0.5",
		"wdio-obsidian-service": "3.3.0",
		"webdriverio": "9.32.0"
	}
}
