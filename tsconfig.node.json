{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"inlineSourceMap": false,
		"inlineSources": false,
		"lib": ["ES2022", "DOM"],
		"target": "ES2022",
		"module": "ESNext"
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"bench/**/*.ts",
		"vitest.config.ts",
		"eslint.config.mts"
	],
	"exclude": ["tests/e2e/**"]
}
